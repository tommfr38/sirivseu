# Copy to `.env` and fill in as needed. All values are optional.

# Optional: NewsAPI.org key for broader coverage beyond RSS.
# Get one free at https://newsapi.org/register
# If unset, the app runs on RSS feeds only.
NEWSAPI_KEY=

# Optional: port for the web server (default 3000).
PORT=3000

# Optional: how long to cache aggregated results, in milliseconds (default 900000 = 15 min).
CACHE_TTL_MS=900000

# Optional: only show articles from the last N days (default 60). Keeps the
# current Siri/EU dispute and filters out older news cycles that search feeds
# can resurface.
MAX_AGE_DAYS=60
